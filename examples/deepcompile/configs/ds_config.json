{
    
    "bf16": {
        "enabled": true
    },
    
    "zero_optimization": {
        "stage": 3,
        "sub_group_size": 100000000
    },
    "compile": {
        "deepcompile": true,
        "global_layer_scheduler": false,
        "global_layer_scheduler_rewrite_comm_ops": true,
        "global_layer_scheduler_lookahead_blocks": 8,
        "global_layer_scheduler_fuse_max_bytes": 536870912,
        "global_layer_scheduler_fuse_deadline_window_blocks": 1,
        "global_layer_scheduler_fuse_factor": 1.0,
        "global_layer_scheduler_include_unmapped_params": true,
        "global_layer_scheduler_set_persistent": true,
        "global_layer_scheduler_inner_refine_max_iters": 512,
        "global_layer_scheduler_inner_refine_min_gain_ms": 0.0,
        "global_layer_scheduler_mem_margin": 0.05,
        "global_layer_scheduler_safety_margin_bytes": 268435456,
        "global_layer_scheduler_outer_keep_max_iters": 32,
        "global_layer_scheduler_outer_keep_min_gain_ms": 0.5,
        "global_layer_scheduler_outer_keep_top_n": 3,
        "global_layer_scheduler_max_tasks_per_block": 64,
        "global_layer_scheduler_dump_schedule": false,
        "global_layer_scheduler_dump_dir": "",
        "offload_activation": false,
        "offload_opt_states": false,
        "double_buffer": true,
        "symmetric_memory": false,
        "free_activation": false,
        "debug_log": false,
        "sync_before_reduce": false,
        "sync_after_reduce": false
    },
    "gradient_accumulation_steps": 1,
    "gradient_clipping": "auto",
    "steps_per_print": 2000,
    "train_batch_size": "auto",
    "train_micro_batch_size_per_gpu": "auto",
    "wall_clock_breakdown": false
}