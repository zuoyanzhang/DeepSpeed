{
    {% if fp16 %}
    "fp16": {
        "enabled": true,
        "initial_scale_power": 8
    },
    {% else %}
    "bf16": {
        "enabled": true
    },
    {% endif %}
    "zero_optimization": {
        "stage": {{ zero_stage }},
        "sub_group_size": 100000000
    },
    "compile": {
        "deepcompile": {{ deepcompile }},
        "global_layer_scheduler": false,
        "selective_activation_recompute": false,
        "selective_activation_recompute_dump_plan": false,
        "selective_activation_recompute_dump_dir": "",
        "selective_activation_recompute_pressure_ratio": 0.95,
        "global_layer_scheduler_fuse_max_bytes": 1073741824,
        "global_layer_scheduler_fuse_deadline_window_blocks": 2,
        "global_layer_scheduler_fuse_factor": 0.95,
        "global_layer_scheduler_inner_refine_max_iters": 2048,
        "global_layer_scheduler_inner_refine_min_gain_ms": 0.01,
        "global_layer_scheduler_milp_time_limit_s": 8.0,
        "global_layer_scheduler_milp_rel_gap": 0.001,
        "global_layer_scheduler_dump_schedule": false,
        "global_layer_scheduler_topology_policy": "generic",
        "global_layer_scheduler_low_comm_keep_opportunity_factor": 0.5,
        "global_layer_scheduler_low_comm_keep_cap_fraction": 0.10,
        "global_layer_scheduler_low_comm_persistent_budget_mode": "selective",
        "global_layer_scheduler_low_comm_persistent_usable_fraction": 0.9,
        "global_layer_scheduler_low_comm_persistent_starvation_fraction": 0.75,
        "global_layer_scheduler_low_comm_graph_rewrite_mode": "local_prefetch",
        "global_layer_scheduler_low_comm_prefetch_fuse_slack": 1.9,
        "global_layer_scheduler_low_comm_prefetch_fuse_max_bytes": 1850000000,
        "global_layer_scheduler_low_comm_prefetch_buffer_max_bytes": 5300000000,
        "global_layer_scheduler_low_comm_elide_persistent_releases": true,
        "global_layer_scheduler_low_comm_elide_persistent_waits": true,
        "global_layer_scheduler_low_comm_elide_persistent_prefetches": true,
        "global_layer_scheduler_low_comm_persistent_value_mode": "event_density",
        "global_layer_scheduler_low_comm_comm_value_weight": 0.25,
        "global_layer_scheduler_low_comm_state_op_ms": 0.02,
        "global_layer_scheduler_low_comm_recompute_relief": false,
        "global_layer_scheduler_low_comm_recompute_pressure_ratio": 0.72,
        "global_layer_scheduler_low_comm_post_step_refresh": false,
        "separate_allgather_communicator": true,
        "global_layer_scheduler_dump_dir": "",
        "offload_activation": false,
        "offload_opt_states": false,
        "double_buffer": true,
        "symmetric_memory": false,
        "free_activation": false,
        "debug_log": {{ debug_log }},
        "sync_before_reduce": {{ sync_before_reduce }},
        "sync_after_reduce": {{ sync_after_reduce }}
    },
    "gradient_accumulation_steps": {{ gradient_accumulation_steps }},
    "gradient_clipping": "auto",
    "steps_per_print": 2000,
    "train_batch_size": "auto",
    "train_micro_batch_size_per_gpu": "auto",
    "wall_clock_breakdown": false
}
